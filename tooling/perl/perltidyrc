# .perltidyrc — @rtorcato/repo-tooling Perl preset
#
# perltidy is the formatter; Perl::Critic (see .perlcriticrc) is the linter.
#
# Order matters in this file: -pbp is a bundle that sets many options at once,
# so every deviation from it has to come afterwards to win.

# Perl Best Practices as the base: 4-column indents, no cuddled else,
# consistent operator spacing.
-pbp

# 100 columns rather than PBP's 78 — the same width the JavaScript and Swift
# presets in this distribution use, so a polyglot repo wraps consistently.
-l=100

# Keep up to two consecutive blank lines instead of collapsing to one:
# deliberate vertical grouping inside a long sub is worth preserving.
-mbl=2

# Deliberately NOT set here: -b (in-place edit) and -bext. They change what a
# bare `perltidy lib/Foo.pm` does for a human running it by hand — it would
# silently rewrite the file instead of producing Foo.pm.tdy. The pre-commit
# hook and the CI job pass those flags explicitly, where in-place is the point.
